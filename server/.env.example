# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local mongodb)
# If omitted or unavailable, the server automatically starts a development in-memory database
MONGO_URI=mongodb://localhost:27017/ai-chat-assistant

# OpenAI / OpenAI-compatible API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom base URL (e.g., https://openrouter.ai/api/v1, http://localhost:11434/v1 for Ollama)
OPENAI_BASE_URL=
# Model name (e.g. gpt-4o-mini, gpt-4o, etc.)
OPENAI_MODEL=gpt-4o-mini

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

